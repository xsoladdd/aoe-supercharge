#!/usr/bin/env node
// Fake `aoe` CLI for tests and demos. Talks to the fake server at $FAKE_AOE_URL.
// `add -w <branch> -b` creates a real git worktree so worker commands can run inside it.
import { execFileSync } from 'node:child_process';
import { mkdirSync } from 'node:fs';
import { basename, dirname, join } from 'node:path';

const url = process.env.FAKE_AOE_URL;
const args = process.argv.slice(2);
const has = (f) => args.includes(f);
const val = (...flags) => {
  for (const f of flags) {
    const i = args.indexOf(f);
    if (i >= 0) return args[i + 1];
  }
  return undefined;
};
const out = (s) => process.stdout.write(s.endsWith('\n') ? s : `${s}\n`);
const die = (s, code = 1) => {
  process.stderr.write(`${s}\n`);
  process.exit(code);
};
async function api(path, init) {
  if (!url) die('FAKE_AOE_URL is not set');
  const res = await fetch(`${url}${path}`, {
    ...init,
    headers: { 'content-type': 'application/json', ...(init?.headers ?? {}) },
  });
  if (!res.ok) die(`fake aoe: ${res.status} ${await res.text()}`);
  return res.json();
}

const cmd = args[0];
if (cmd === '--version' || cmd === '-V') {
  const s = url ? await api('/__fake/state') : { version: '1.17.2' };
  out(`aoe ${s.version}`);
} else if (cmd === 'url') {
  const s = await api('/__fake/state');
  out(has('--token-only') ? s.token : `${url}/?token=${s.token}`);
} else if (cmd === 'serve') {
  if (has('--status')) {
    try {
      await fetch(`${url}/__fake/state`);
      out(`Daemon: running (PID ${process.pid})\nMode:   local\nURL:    ${url}/?token=<redacted>`);
    } catch {
      die('No daemon running', 1);
    }
  } else out('ok');
} else if (cmd === 'list') {
  out(JSON.stringify(await api('/__fake/cli/list')));
} else if (cmd === 'status') {
  const s = await api('/__fake/state');
  const count = (st) => s.sessions.filter((x) => x.status === st).length;
  out(
    JSON.stringify({
      waiting: count('Waiting'),
      running: count('Running'),
      idle: count('Idle'),
      stopped: count('Stopped'),
      error: count('Error'),
      total: s.sessions.length,
    }),
  );
} else if (cmd === 'profile') {
  out('Profiles:\n  * main (default)\n\nTotal: 1 profiles');
} else if (cmd === 'add') {
  const repo = args[1];
  const title = val('-t', '--title');
  const parent = val('-P', '--parent') ?? null;
  const branch = val('-w', '--worktree') ?? null;
  const base = val('--base-branch') ?? 'main';
  let path = repo;
  if (branch) {
    path = join(dirname(repo), `${basename(repo)}-worktrees`, branch.replace(/[/@#\\:*?"<>|]/g, '-'));
    mkdirSync(dirname(path), { recursive: true });
    try {
      execFileSync(
        'git',
        [
          '-C',
          repo,
          'worktree',
          'add',
          ...(has('-b') ? ['-b', branch] : []),
          path,
          ...(has('-b') ? [base] : [branch]),
        ],
        { stdio: 'pipe' },
      );
    } catch (e) {
      die(`git worktree add failed: ${e.stderr?.toString() ?? e.message}`);
    }
  }
  const parentSession = parent ? (await api('/__fake/state')).sessions.find((s) => s.id === parent) : null;
  const s = await api('/__fake/sessions', {
    method: 'POST',
    body: JSON.stringify({
      title,
      project_path: path,
      main_repo_path: branch ? repo : null,
      branch,
      base_branch: branch ? base : null,
      parent_session_id: parent,
      group_path: parentSession?.group_path ?? val('-g', '--group') ?? '',
      status: has('-l') ? 'Running' : 'Idle',
    }),
  });
  out(`Created session ${s.id}`);
  if (process.env.FAKE_AOE_LAUNCH_FAIL === '1' && has('-l')) {
    process.stderr.write(
      'Warning: launch failed: agent hook paths have not been acknowledged; approve them in the AoE TUI before launching this host session.\n',
    );
    process.exit(1);
  }
} else if (cmd === 'session' && args[1] === 'show') {
  out(JSON.stringify(await api(`/__fake/agent/${args[2]}`)));
} else if (cmd === 'send') {
  await api('/__fake/send', { method: 'POST', body: JSON.stringify({ id: args[1], message: args[2] }) });
  out('sent');
} else if (cmd === 'update') {
  const s = url ? await api('/__fake/state') : { version: '1.17.2' };
  out(
    `current: ${s.version}\nlatest:  ${process.env.FAKE_AOE_LATEST ?? s.version}\navailable: ${(process.env.FAKE_AOE_LATEST ?? s.version) !== s.version}`,
  );
} else {
  die(`fake aoe: unsupported command ${args.join(' ')}`, 2);
}
