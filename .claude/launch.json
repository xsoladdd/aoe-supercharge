{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5180,
      "url": "http://localhost:5180"
    },
    {
      "name": "demo",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "demo:nobuild"
      ],
      "port": 4391,
      "url": "http://localhost:4391"
    },
    {
      "name": "demo-live",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "demo:nobuild",
        "--",
        "--live"
      ],
      "port": 4391,
      "url": "http://localhost:4391"
    }
  ]
}
