{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "jsx": "react-jsx",
    "types": ["node"],
    "paths": {
      "@aoe-supercharge/core/shared": ["./packages/core/src/shared/index.ts"],
      "@aoe-supercharge/core/node": ["./packages/core/src/node/index.ts"],
      "@/*": ["./packages/ui/src/*"]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true
  }
}
