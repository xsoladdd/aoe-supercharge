{
  "name": "aoe-supercharge-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "npm run build -w @aoe-supercharge/ui && npm run build -w aoe-supercharge",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "dev:ui": "npm run dev -w @aoe-supercharge/ui",
    "demo": "npm run build && tsx scripts/demo.ts",
    "demo:nobuild": "tsx scripts/demo.ts",
    "demo:open": "tsx scripts/demo-open.ts",
    "dev": "tsx scripts/dev.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.63",
    "@types/node": "^24.19.1",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
